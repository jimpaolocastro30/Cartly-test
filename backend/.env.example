# Port the NestJS API listens on
PORT=3000

# Firebase / Google Cloud project ID
FIREBASE_PROJECT_ID=cartly-dev

# Path to a Firebase service-account JSON key (real project only).
# Leave empty when using the Firestore Emulator.
GOOGLE_APPLICATION_CREDENTIALS=

# Set to use the local Firestore Emulator instead of a real project.
# Remove or leave empty to connect to the real Firestore database.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
